# Current v2 control plane. Omitted config/state paths are resolved from
# ARCTURUS_*_ROOT, then XDG_*_HOME, then the rootless defaults. Run
# `deploy/arcturus_paths.py` to inspect the exact layout.
ARCTURUS_ALLOWED_BIND_ROOTS=/absolute/path/to/apps

# Optional router integration
CERT_DOMAIN=example.org
ARCTURUS_APEX_SERVICE=
NGINX_CONTAINER=portal-nginx
PORTAL_VHOSTS_DIR=/absolute/path/to/portal/config/nginx/vhosts.d
PORTAL_STREAMS_DIR=/absolute/path/to/portal/config/nginx/streams.d

# Deprecated v1 compatibility only. Do not reuse these as v2 deployment tokens.
STACKS_BASE_DIR=/absolute/path/to/legacy-stacks
WEBHOOK_SECRET=
DISCORD_WEBHOOK_URL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
