[Unit]
Description=Arcturus message bus
After=network.target

[Service]
Type=simple
EnvironmentFile="@CONFIG_DIR@/platform.env"
ExecStartPre=/usr/bin/mkdir -p "@RUNTIME_DIR@"
ExecStart=/usr/bin/node "@STATE_DIR@/current/modules/bus/dist/index.js"
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="@RUNTIME_DIR@"

[Install]
WantedBy=default.target
