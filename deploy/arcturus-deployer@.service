[Unit]
Description=Arcturus host deployment API on %I
After=network-online.target arcturus-podman-api.service arcturus-registry.service
Wants=network-online.target arcturus-podman-api.service arcturus-registry.service

[Service]
Type=simple
WorkingDirectory="@STATE_DIR@/current"
EnvironmentFile="@CONFIG_DIR@/deployer.env"
EnvironmentFile=-"@CONFIG_DIR@/registry.env"
Environment=PYTHONUNBUFFERED=1
ExecStart="@STATE_DIR@/current/venv/bin/python" -m uvicorn image_policy_app:app --host %I --port 9090 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="@STATE_DIR@" "@QUADLET_DIR@" "@UNIT_DIR@" "@RUNTIME_DIR@"

[Install]
WantedBy=default.target
