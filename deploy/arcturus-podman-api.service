[Unit]
Description=Always-on rootless Podman API for Arcturus
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-@CONFIG_DIR@/registry.env
ExecStartPre=/usr/bin/mkdir -p "@RUNTIME_DIR@"
ExecStart=/usr/bin/podman system service --time=0 "unix://@RUNTIME_DIR@/podman.sock"
ExecStopPost=/usr/bin/rm -f "@RUNTIME_DIR@/podman.sock"
Restart=always
RestartSec=2s

[Install]
WantedBy=default.target
