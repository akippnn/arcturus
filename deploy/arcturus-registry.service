[Unit]
Description=Arcturus manifest registry
After=arcturus-bus.service
Wants=arcturus-bus.service

[Service]
Type=simple
EnvironmentFile=@CONFIG_DIR@/platform.env
ExecStartPre=/usr/bin/mkdir -p "@RUNTIME_DIR@"
ExecStart=/usr/bin/node "@STATE_DIR@/current/modules/registry/dist/index.js"
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="@RUNTIME_DIR@" "@STATE_DIR@/active-manifests"

[Install]
WantedBy=default.target
