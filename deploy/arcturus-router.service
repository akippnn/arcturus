[Unit]
Description=Arcturus nginx route publisher
After=arcturus-registry.service
Wants=arcturus-registry.service

[Service]
Type=simple
EnvironmentFile="@CONFIG_DIR@/platform.env"
ExecStart=/usr/bin/node "@STATE_DIR@/current/modules/router/dist/index.js"
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="@RUNTIME_DIR@" "@WORKLOAD_ROOT@"

[Install]
WantedBy=default.target
