#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
paths_helper="$script_dir/arcturus_paths.py"
[[ -f "$paths_helper" ]] || {
  echo "Arcturus path resolver is missing beside arcturusctl: $paths_helper" >&2
  exit 2
}
state_dir="$(python3 "$paths_helper" --get deployer_state_dir)"
python="$state_dir/current/venv/bin/python3"
[[ -x "$python" ]] || python="$state_dir/venv/bin/python3"
script="$state_dir/current/arcturusctl.py"
[[ -f "$script" ]] || script="$script_dir/arcturusctl.py"
exec "$python" "$script" "$@"
