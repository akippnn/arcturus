[Unit]
Description=Arcturus Rust OCI authorization and artifact verification
After=network-online.target
Wants=network-online.target
Before=arcturus-oci-registry.service

[Service]
Type=simple
EnvironmentFile=@CONFIG_DIR@/arcturusd.env
ExecStart="@STATE_DIR@/current/arcturusd"
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-"@OCI_AUTH_STATE_DIR@" -"@FLEET_STATE_DIR@" "@RUNTIME_DIR@"

[Install]
WantedBy=default.target
